# Rust 构建产物
target/

# Tauri 自动生成文件
gen/

# Cargo 本地配置（代理、注册表缓存等）
.cargo/config.toml
.cargo/run-proxy.ps1
.cargo/registry/
.cargo/advisories/
.cargo/config

# Rustup 工具链配置（用户本地）
.rustup/

# 环境变量文件
.env
.env.*

# IDE 配置
.idea/
.vscode/
.trae/
*.swp
*.swo
*~

# 操作系统文件
.DS_Store
Thumbs.db
Desktop.ini

# Node.js（如有前端构建工具）
node_modules/

# 日志文件
*.log

# 构建输出（开发调试产物）
build_output.txt

# 误操作的脚本文件（开发者可能在命令行误执行保存）
klist*

# 浏览器/IDE 调试日志（与项目无关）
debug.log

# Rust 编译中间产物（非 target/ 下的散落文件）
*.pdb
*.d
*.exp

# 临时文件与本地构建目录
*.tmp
*.temp
portable/
artifacts/
release/
release_artifacts/
.crate-cache/
*.crate

# Cargo audit 数据库（可选缓存）
.cargo/advisories/

# Cargo registry 缓存
.cargo/registry/

# 签名密钥（安全敏感）
*.pem
*.pfx
*.p12
*.key
